rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sin autenticacion (fuera del alcance, riesgo 4 del documento):
    // solo se permiten las colecciones del proyecto, y cada escritura
    // debe tener la forma que definen las clases Tarea y Categoria.

    function esTareaValida(d) {
      return d.keys().hasOnly(['titulo', 'descripcion', 'fechaEntrega', 'prioridad', 'estado', 'categoriaId'])
        && d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 100
        && d.descripcion is string && d.descripcion.size() <= 1000
        && d.fechaEntrega is string && d.fechaEntrega.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.prioridad in ['baja', 'media', 'alta']
        && d.estado in ['pendiente', 'completada']
        && d.categoriaId is string;
    }

    function esCategoriaValida(d) {
      return d.keys().hasOnly(['nombre', 'color'])
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 30
        && d.color is string && d.color.matches('^#[0-9a-fA-F]{6}$');
    }

    match /tareas/{id} {
      allow read, delete: if true;
      allow create, update: if esTareaValida(request.resource.data);
    }
    match /categorias/{id} {
      allow read, delete: if true;
      allow create, update: if esCategoriaValida(request.resource.data);
    }
  }
}
